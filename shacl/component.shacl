@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix data: <https://mtconnect.org/data/> .
@prefix val: <https://purl.mtconnect.org/shacl/> .
@prefix mt: <https://purl.mtconnect.org/ontology/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

val:MustHaveComponentOrDataItemOrReference
    a sh:NodeShape ;
    sh:message "`Component` **MUST** have at least one of `Component`, `DataItem` or  `Reference` entities." ;
    sh:targetClass mt:Component ;
    sh:or (
        [ sh:property [
            sh:path mt:hasComponent ;
            sh:minCount 1 ;
            sh:class mt:Component ;
        ] ]
        [ sh:property [
            sh:path mt:observes ;
            sh:minCount 1 ;
            sh:class mt:DataItem ;
        ] ]
        [ sh:property [
            sh:path mt:hasReference ;
            sh:minCount 1 ;
            sh:class mt:Reference ;
        ] ]
    ) .

val:ComponentMustHaveId
    a sh:NodeShape ;
    sh:message "Component must have id." ;
    sh:targetClass mt:Component ;
    sh:property [
          sh:path mt:hasId ;
          sh:datatype xsd:string ;
          sh:pattern "^[a-zA-Z_][a-zA-Z0-9_\\-]*$" ;
          sh:minCount 1 ;
    ] .