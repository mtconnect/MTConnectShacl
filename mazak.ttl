#################################################################
#    General axioms
#################################################################

[ owl:intersectionOf ( mt:Device
                       [ rdfv:type owl:Restriction ;
                         owl:onProperty mt:hasComponent ;
                         owl:someValuesFrom [ owl:intersectionOf ( mt:Controller
                                                                   [ rdfv:type owl:Restriction ;
                                                                     owl:onProperty mt:hasComponent ;
                                                                     owl:someValuesFrom [ owl:intersectionOf ( mt:Path
                                                                                                               [ rdfv:type owl:Restriction ;
                                                                                                                 owl:onProperty mt:observes ;
                                                                                                                 owl:someValuesFrom mt:ControllerMode
                                                                                                               ]
                                                                                                               [ rdfv:type owl:Restriction ;
                                                                                                                 owl:onProperty mt:observes ;
                                                                                                                 owl:someValuesFrom mt:Execution
                                                                                                               ]
                                                                                                             ) ;
                                                                                          rdfv:type owl:Class
                                                                                        ]
                                                                   ]
                                                                 ) ;
                                              rdfv:type owl:Class
                                            ]
                       ]
                     ) ;
  rdfv:type owl:Class ;
  rdfs:subClassOf mt:ComputeAvailability
] .


[ owl:intersectionOf ( mt:Device
                       [ rdfv:type owl:Restriction ;
                         owl:onProperty mt:hasComponent ;
                         owl:someValuesFrom [ owl:intersectionOf ( mt:Controller
                                                                   [ rdfv:type owl:Restriction ;
                                                                     owl:onProperty mt:hasComponent ;
                                                                     owl:someValuesFrom [ owl:intersectionOf ( mt:Path
                                                                                                               [ rdfv:type owl:Restriction ;
                                                                                                                 owl:onProperty mt:observes ;
                                                                                                                 owl:someValuesFrom mt:ControllerMode
                                                                                                               ]
                                                                                                               [ rdfv:type owl:Restriction ;
                                                                                                                 owl:onProperty mt:observes ;
                                                                                                                 owl:someValuesFrom mt:Execution
                                                                                                               ]
                                                                                                             ) ;
                                                                                          rdfv:type owl:Class
                                                                                        ]
                                                                   ]
                                                                 ) ;
                                              rdfv:type owl:Class
                                            ]
                       ]
                     ) ;
  rdfv:type owl:Class ;
  rdfs:subClassOf mt:ControllerModeCapability
] .


[ rdfv:type owl:AllDisjointClasses ;
  owl:members ( mt:ElectricalSystem
                mt:HydraulicSystem
                mt:LubricationSystem
                mt:PneumaticSystem
              )
] .


[ rdfv:type owl:AllDifferent ;
  owl:distinctMembers ( data:Mazak-a-br
                        data:Mazak-a-c
                        data:Mazak-a-c2
                      )
] .


[ rdfv:type owl:AllDifferent ;
  owl:distinctMembers ( data:Mazak-a-br
                        data:Mazak-a-c
                        data:Mazak-a-c2
                        data:Mazak-a-x
                        data:Mazak-a-y
                        data:Mazak-a-z
                      )
] .


[ rdfv:type owl:AllDifferent ;
  owl:distinctMembers ( data:Mazak-mstruct
                        data:Mazak-mstruct-table
                        data:Mazak-mstruct-trundle
                        data:Mazak-mstruct-xaxism
                        data:Mazak-mstruct-yaxism
                        data:Mazak-mstruct-zaxis
                      )
] .


