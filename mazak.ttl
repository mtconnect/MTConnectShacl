                           data:Mazak-door1 ,
                           data:Mazak-enclosurem ,
                           data:Mazak-mstruct ,
                           data:Mazak-partocc ,
                           data:Mazak-procstock ,
                           data:Mazak-systems ;
           mt:hasIdentifier "Mazak" ;
           mt:hasName "Mazak" .


