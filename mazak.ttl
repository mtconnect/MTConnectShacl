@prefix data: <http://example.com/data/> .
@prefix mt: <https://purl.mtconnect.org/ontology/construct/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdfv: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xs: <http://www.w3.org/2001/XMLSchema#> .

data: a owl:Ontology;
  rdfs:label "Machine Ontology"@en-us;
  owl:imports <https://purl.mtconnect.org/ontology/Device/> .

data:Mazak a mt:Device;
  mt:hasCapability data:Mazak-capability;
  mt:hasComponent data:Mazak-mstruct,
    data:Mazak-a,
    data:Mazak-cont,
    data:Mazak-door1,
    data:Mazak-partocc,
    data:Mazak-systems,
    data:Mazak-procstock,
    data:Mazak-enclosurem;
  mt:hasIdentifier "Mazak";
  mt:hasName "Mazak";
  mt:observes data:Mazak-Availability .

mt:Ballscrew a owl:Class;
  rdfs:label "ballscrew"@en-us;
  rdfs:subClassOf mt:Component .

mt:Condition a owl:Class;
  rdfs:label "condition"@en-us;
  rdfs:subClassOf mt:DataItem .

mt:Motor a owl:Class;
  rdfs:label "motor"@en-us;
  rdfs:subClassOf mt:Component .

mt:Room a owl:Class;
  rdfs:label "room"@en-us;
  rdfs:subClassOf mt:Component .

mt:Sensor a owl:Class;
  rdfs:label "sensor"@en-us;
  rdfs:subClassOf mt:Component .

mt:_alldis1 a owl:AllDisjointClasses;
  owl:members (mt:ElectricalSystem mt:HydraulicSystem mt:LubricationSystem mt:PneumaticSystem) .

mt:componentOf a owl:ObjectProperty;
  rdfs:label "has component"@en-us;
  rdfs:domain mt:Component;
  rdfs:range mt:Component;
  owl:inverseOf mt:hasComponent .

mt:hasIdentifier a owl:DatatypeProperty;
  rdfs:label "has identifier"@en-us;
  rdfs:range xs:string .

mt:hasName a owl:DatatypeProperty;
  rdfs:label "has name"@en-us;
  rdfs:range xs:string .

mt:hasUnits a owl:DatatypeProperty;
  rdfs:label "has units"@en-us;
  rdfs:range xs:string .

mt:isCapabilityOf a owl:ObjectProperty;
  rdfs:label "is capability of"@en-us;
  rdfs:domain mt:Capability;
  rdfs:range mt:Component;
  owl:inverseOf mt:hasCapability .

mt:observedBy a owl:ObjectProperty;
  rdfs:label "observed by"@en-us;
  owl:inverseOf mt:observes .

data:Mazak-Availability a mt:Availability;
  mt:hasIdentifier "avail" .

data:Mazak-a-br-capability a mt:Capability .

data:Mazak-a-c-capability a mt:Capability .

data:Mazak-a-c2-capability a mt:Capability .

data:Mazak-a-capability a mt:Capability .

data:Mazak-a-x-PositionActual a mt:PositionActual;
  mt:hasIdentifier "Xabs" .

data:Mazak-a-x-PositionProgrammed a mt:PositionProgrammed;
  mt:hasIdentifier "Xpos" .

data:Mazak-a-x-capability a mt:Capability .

data:Mazak-a-y-PositionActual a mt:PositionActual;
  mt:hasIdentifier "Yabs" .

data:Mazak-a-y-PositionProgrammed a mt:PositionProgrammed;
  mt:hasIdentifier "Ypos" .

data:Mazak-a-y-capability a mt:Capability .

data:Mazak-a-z-PositionActual a mt:PositionActual;
  mt:hasIdentifier "Zabs" .

data:Mazak-a-z-PositionProgrammed a mt:PositionProgrammed;
  mt:hasIdentifier "Zpos" .

data:Mazak-a-z-capability a mt:Capability .

data:Mazak-capability a mt:Capability .

data:Mazak-cont-capability a mt:Capability .

data:Mazak-cont-path1-ControllerMode a mt:ControllerMode;
  mt:hasIdentifier "mode" .

data:Mazak-cont-path1-Execution a mt:Execution;
  mt:hasIdentifier "execution" .

data:Mazak-cont-path1-PathPosition a mt:PathPosition;
  mt:hasIdentifier "pathpos" .

data:Mazak-cont-path1-capability a mt:Capability .

data:Mazak-door1-capability a mt:Capability .

data:Mazak-enclosurem-capability a mt:Capability .

data:Mazak-mstruct-capability a mt:Capability .

data:Mazak-mstruct-table-capability a mt:Capability .

data:Mazak-mstruct-trundle-capability a mt:Capability .

data:Mazak-mstruct-xaxism-capability a mt:Capability .

data:Mazak-mstruct-yaxism-capability a mt:Capability .

data:Mazak-mstruct-zaxis-capability a mt:Capability .

data:Mazak-partocc-capability a mt:Capability .

data:Mazak-procstock-capability a mt:Capability .

data:Mazak-systems-capability a mt:Capability .

<https://purl.mtconnect.org/ontology/Device/> a owl:Ontology;
  rdfs:label "MTConnect Ontology"@en-us .

mt:Axes a owl:Class;
  rdfs:label "axes"@en-us;
  rdfs:subClassOf mt:Component, [
    a owl:Restriction;
    owl:allValuesFrom mt:Axis;
    owl:onProperty mt:hasComponent
  ] .

mt:ControllerMode a owl:Class;
  rdfs:label "controller mode"@en-us;
  rdfs:subClassOf mt:Event .

mt:Device a owl:Class;
  rdfs:label "machine"@en-us;
  rdfs:subClassOf mt:Component, [
    a owl:Restriction;
    owl:onProperty mt:observes;
    owl:someValuesFrom mt:Availability
  ] .

mt:Door a owl:Class;
  rdfs:label "door"@en-us;
  rdfs:subClassOf mt:Component .

mt:ElectricalSystem a owl:Class;
  rdfs:label "electrical system"@en-us;
  rdfs:subClassOf mt:System .

mt:Enclosure a owl:Class;
  rdfs:label "enclosure"@en-us;
  rdfs:subClassOf mt:Component .

mt:Execution a owl:Class;
  rdfs:label "execution"@en-us;
  rdfs:subClassOf mt:Event .

mt:HydraulicSystem a owl:Class;
  rdfs:label "hydraulic system"@en-us;
  rdfs:subClassOf mt:System .

mt:LubricationSystem a owl:Class;
  rdfs:label "lubrication system"@en-us;
  rdfs:subClassOf mt:System .

mt:PartOccurrence a owl:Class;
  rdfs:label "part"@en-us;
  rdfs:subClassOf mt:Component .

mt:Path a owl:Class;
  rdfs:label "control system path"@en-us;
  rdfs:subClassOf mt:Controller .

mt:PathPosition a owl:Class;
  rdfs:label "path position"@en-us;
  rdfs:subClassOf mt:Sample .

mt:PneumaticSystem a owl:Class;
  rdfs:label "pneumatic system"@en-us;
  rdfs:subClassOf mt:System .

mt:Stock a owl:Class;
  rdfs:label "stock"@en-us;
  rdfs:subClassOf mt:Component .

mt:Structure a owl:Class;
  rdfs:label "enclosure"@en-us;
  rdfs:subClassOf mt:Component .

mt:Structures a owl:Class;
  rdfs:label "structure"@en-us;
  rdfs:subClassOf mt:Component .

mt:Systems a owl:Class;
  rdfs:label "systems"@en-us;
  rdfs:subClassOf mt:Component .

mt:hasCapability a owl:ObjectProperty;
  rdfs:label "has capability"@en-us;
  rdfs:domain mt:Component;
  rdfs:range mt:Capability .

data:Mazak-a a mt:Axes;
  mt:hasCapability data:Mazak-a-capability;
  mt:hasComponent data:Mazak-a-x,
    data:Mazak-a-y,
    data:Mazak-a-z,
    data:Mazak-a-c,
    data:Mazak-a-br,
    data:Mazak-a-c2;
  mt:hasIdentifier "a";
  mt:hasName "base" .

data:Mazak-a-br a mt:Rotary;
  mt:hasCapability data:Mazak-a-br-capability;
  mt:hasIdentifier "br";
  mt:hasName "B" .

data:Mazak-a-c a mt:Rotary;
  mt:hasCapability data:Mazak-a-c-capability;
  mt:hasIdentifier "c";
  mt:hasName "C1" .

data:Mazak-a-c2 a mt:Rotary;
  mt:hasCapability data:Mazak-a-c2-capability;
  mt:hasIdentifier "c2";
  mt:hasName "C2" .

data:Mazak-a-x a mt:Linear;
  mt:hasCapability data:Mazak-a-x-capability;
  mt:hasIdentifier "x";
  mt:hasName "X";
  mt:observes data:Mazak-a-x-PositionActual,
    data:Mazak-a-x-PositionProgrammed .

data:Mazak-a-y a mt:Linear;
  mt:hasCapability data:Mazak-a-y-capability;
  mt:hasIdentifier "y";
  mt:hasName "Y";
  mt:observes data:Mazak-a-y-PositionActual,
    data:Mazak-a-y-PositionProgrammed .

data:Mazak-a-z a mt:Linear;
  mt:hasCapability data:Mazak-a-z-capability;
  mt:hasIdentifier "z";
  mt:hasName "Z";
  mt:observes data:Mazak-a-z-PositionActual,
    data:Mazak-a-z-PositionProgrammed .

data:Mazak-cont a mt:Controller;
  mt:hasCapability data:Mazak-cont-capability;
  mt:hasComponent data:Mazak-cont-path1;
  mt:hasIdentifier "cont";
  mt:hasName "controller" .

data:Mazak-cont-path1 a mt:Path;
  mt:hasCapability data:Mazak-cont-path1-capability;
  mt:hasIdentifier "path1";
  mt:hasName "path";
  mt:observes data:Mazak-cont-path1-PathPosition,
    data:Mazak-cont-path1-Execution,
    data:Mazak-cont-path1-ControllerMode .

data:Mazak-door1 a mt:Door;
  mt:hasCapability data:Mazak-door1-capability;
  mt:hasIdentifier "door1";
  mt:hasName "door" .

data:Mazak-enclosurem a mt:Enclosure;
  mt:hasCapability data:Mazak-enclosurem-capability;
  mt:hasIdentifier "enclosurem";
  mt:hasName "enclosure" .

data:Mazak-mstruct a mt:Structures;
  mt:hasCapability data:Mazak-mstruct-capability;
  mt:hasComponent data:Mazak-mstruct-xaxism,
    data:Mazak-mstruct-yaxism,
    data:Mazak-mstruct-zaxis,
    data:Mazak-mstruct-table,
    data:Mazak-mstruct-trundle;
  mt:hasIdentifier "mstruct" .

data:Mazak-mstruct-table a mt:Link;
  mt:hasCapability data:Mazak-mstruct-table-capability;
  mt:hasIdentifier "table";
  mt:hasName "TABLE" .

data:Mazak-mstruct-trundle a mt:Link;
  mt:hasCapability data:Mazak-mstruct-trundle-capability;
  mt:hasIdentifier "trundle";
  mt:hasName "TRUNDLE" .

data:Mazak-mstruct-xaxism a mt:Link;
  mt:hasCapability data:Mazak-mstruct-xaxism-capability;
  mt:hasIdentifier "xaxism";
  mt:hasName "X_AXIS" .

data:Mazak-mstruct-yaxism a mt:Link;
  mt:hasCapability data:Mazak-mstruct-yaxism-capability;
  mt:hasIdentifier "yaxism";
  mt:hasName "Y_AXIS" .

data:Mazak-mstruct-zaxis a mt:Link;
  mt:hasCapability data:Mazak-mstruct-zaxis-capability;
  mt:hasIdentifier "zaxis";
  mt:hasName "Z_AXIS" .

data:Mazak-partocc a mt:PartOccurrence;
  mt:hasCapability data:Mazak-partocc-capability;
  mt:hasIdentifier "partocc" .

data:Mazak-procstock a mt:Stock;
  mt:hasCapability data:Mazak-procstock-capability;
  mt:hasIdentifier "procstock";
  mt:hasName "stock" .

data:Mazak-systems a mt:Systems;
  mt:hasCapability data:Mazak-systems-capability;
  mt:hasIdentifier "systems";
  mt:hasName "systems" .

mt:Availability a owl:Class;
  rdfs:label "availability"@en-us;
  rdfs:subClassOf mt:Event .

mt:Controller a owl:Class;
  rdfs:label "controller"@en-us;
  rdfs:subClassOf mt:Component .

mt:Position a owl:Class;
  rdfs:label "position"@en-us;
  rdfs:subClassOf mt:Sample .

mt:Sample a owl:Class;
  rdfs:label "sample"@en-us;
  rdfs:subClassOf mt:DataItem .

mt:hasComponent a owl:ObjectProperty;
  rdfs:label "has component"@en-us;
  rdfs:domain mt:Component;
  rdfs:range mt:Component .

mt:observes a owl:ObjectProperty;
  rdfs:label "observes"@en-us;
  rdfs:domain mt:Component;
  rdfs:range mt:DataItem .

mt:Axis a owl:Class;
  rdfs:label "axis"@en-us;
  rdfs:subClassOf mt:Component .

mt:Event a owl:Class;
  rdfs:label "event"@en-us;
  rdfs:subClassOf mt:DataItem .

mt:PositionActual a owl:Class;
  rdfs:label "actual position"@en-us;
  rdfs:subClassOf mt:Position .

mt:PositionProgrammed a owl:Class;
  rdfs:label "programmed position"@en-us;
  rdfs:subClassOf mt:Position .

mt:Rotary a owl:Class;
  rdfs:label "rotary motion system"@en-us;
  rdfs:subClassOf mt:Axis;
  owl:disjointWith mt:Linear .

mt:DataItem a owl:Class;
  rdfs:label "data item"@en-us .

mt:Linear a owl:Class;
  rdfs:label "linear motion system"@en-us;
  rdfs:subClassOf mt:Axis .

mt:System a owl:Class;
  rdfs:label "system"@en-us;
  rdfs:subClassOf mt:Component .

mt:Link a owl:Class;
  rdfs:label "link"@en-us;
  rdfs:subClassOf mt:Structure .

mt:Capability a owl:Class;
  rdfs:label "capability"@en-us .

mt:Component a owl:Class;
  rdfs:label "component"@en-us .

 [
    a owl:AllDifferent;
    owl:distinctMembers (data:Mazak-mstruct-xaxism data:Mazak-mstruct-yaxism data:Mazak-mstruct-zaxis data:Mazak-mstruct-table data:Mazak-mstruct-trundle)
  ] .

 [
    a owl:AllDifferent;
    owl:distinctMembers (data:Mazak-a-x data:Mazak-a-y data:Mazak-a-z data:Mazak-a-c data:Mazak-a-br data:Mazak-a-c2)
  ] .

 [
    a owl:AllDifferent;
    owl:distinctMembers (data:Mazak-cont-path1)
  ] .

 [
    a owl:AllDifferent;
    owl:distinctMembers (data:Mazak-partocc)
  ] .

 [
    a owl:AllDifferent;
    owl:distinctMembers (data:Mazak-procstock)
  ] .

 [
    a owl:AllDifferent;
    owl:distinctMembers (data:Mazak-mstruct data:Mazak-a data:Mazak-cont data:Mazak-door1 data:Mazak-systems data:Mazak-enclosurem)
  ] .
