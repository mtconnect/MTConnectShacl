@prefix : <http://example.com/data/> .
@prefix mt: <https://purl.mtconnect.org/ontology/construct/> .
@prefix xs: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix data: <http://example.com/data/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdfv: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@base <http://example.com/data/> .

<http://example.com/data/> rdfv:type owl:Ontology ;
                            owl:imports <https://purl.mtconnect.org/ontology/Capability/> ;
                            rdfs:label "MTConnect Ontology"@en-us ,
                                       "Machine Ontology"@en-us .

#################################################################
#    Object Properties
#################################################################

###  https://purl.mtconnect.org/ontology/construct/componentOf
mt:componentOf rdfv:type owl:ObjectProperty ;
               owl:inverseOf mt:hasComponent ;
               rdfs:domain mt:Component ;
               rdfs:range mt:Component ;
               rdfs:label "has component"@en-us .


###  https://purl.mtconnect.org/ontology/construct/hasCapability
mt:hasCapability rdfv:type owl:ObjectProperty ;
                 owl:inverseOf mt:isCapabilityOf ;
                 rdfs:domain mt:Component ;
                 rdfs:range mt:Capability .


###  https://purl.mtconnect.org/ontology/construct/hasComponent
mt:hasComponent rdfv:type owl:ObjectProperty ;
                rdfs:domain mt:Component ;
                rdfs:range mt:Component ;
                rdfs:label "has component"@en-us .


###  https://purl.mtconnect.org/ontology/construct/isCapabilityOf
mt:isCapabilityOf rdfv:type owl:ObjectProperty ;
                  rdfs:domain mt:Capability ;
                  rdfs:range mt:Component .


###  https://purl.mtconnect.org/ontology/construct/observedBy
mt:observedBy rdfv:type owl:ObjectProperty ;
              owl:inverseOf mt:observes ;
              rdfs:label "observed by"@en-us .


###  https://purl.mtconnect.org/ontology/construct/observes
mt:observes rdfv:type owl:ObjectProperty ;
            rdfs:domain mt:Component ;
            rdfs:range mt:DataItem ;
            rdfs:label "observes"@en-us .


#################################################################
#    Data properties
#################################################################

###  https://purl.mtconnect.org/ontology/construct/hasIdentifier
mt:hasIdentifier rdfv:type owl:DatatypeProperty ;
                 rdfs:range xsd:string ;
                 rdfs:label "has identifier"@en-us .


###  https://purl.mtconnect.org/ontology/construct/hasName
mt:hasName rdfv:type owl:DatatypeProperty ;
           rdfs:range xsd:string ;
           rdfs:label "has name"@en-us .


###  https://purl.mtconnect.org/ontology/construct/hasUnits
mt:hasUnits rdfv:type owl:DatatypeProperty ;
            rdfs:range xsd:string ;
            rdfs:label "has units"@en-us .


#################################################################
#    Classes
#################################################################

###  https://purl.mtconnect.org/ontology/construct/Axes
mt:Axes rdfv:type owl:Class ;
        rdfs:subClassOf mt:Component ,
                        [ rdfv:type owl:Restriction ;
                          owl:onProperty mt:hasComponent ;
                          owl:someValuesFrom mt:Axis
                        ] ;
        rdfs:label "axes"@en-us .


###  https://purl.mtconnect.org/ontology/construct/Axis
mt:Axis rdfv:type owl:Class ;
        rdfs:subClassOf mt:Component ;
        rdfs:label "axis"@en-us .


###  https://purl.mtconnect.org/ontology/construct/Ballscrew
mt:Ballscrew rdfv:type owl:Class ;
             rdfs:subClassOf mt:Component ;
             rdfs:label "ballscrew"@en-us .


###  https://purl.mtconnect.org/ontology/construct/Capability
mt:Capability rdfv:type owl:Class ;
              rdfs:label "capability"@en-us .


###  https://purl.mtconnect.org/ontology/construct/Component
mt:Component rdfv:type owl:Class ;
             rdfs:label "component"@en-us .


###  https://purl.mtconnect.org/ontology/construct/ComputeAvailability
mt:ComputeAvailability owl:equivalentClass [ owl:intersectionOf ( mt:Device
                                                                  [ rdfv:type owl:Restriction ;
                                                                    owl:onProperty mt:hasComponent ;
                                                                    owl:someValuesFrom [ owl:intersectionOf ( mt:Controller
                                                                                                              [ rdfv:type owl:Restriction ;
                                                                                                                owl:onProperty mt:hasComponent ;
                                                                                                                owl:someValuesFrom [ owl:intersectionOf ( mt:Path
                                                                                                                                                          [ rdfv:type owl:Restriction ;
                                                                                                                                                            owl:onProperty mt:observes ;
                                                                                                                                                            owl:someValuesFrom mt:ControllerMode
                                                                                                                                                          ]
                                                                                                                                                          [ rdfv:type owl:Restriction ;
                                                                                                                                                            owl:onProperty mt:observes ;
                                                                                                                                                            owl:someValuesFrom mt:Execution
                                                                                                                                                          ]
                                                                                                                                                        ) ;
                                                                                                                                     rdfv:type owl:Class
                                                                                                                                   ]
                                                                                                              ]
                                                                                                            ) ;
                                                                                         rdfv:type owl:Class
                                                                                       ]
                                                                  ]
                                                                ) ;
                                             rdfv:type owl:Class
                                           ] .


###  https://purl.mtconnect.org/ontology/construct/Condition
mt:Condition rdfv:type owl:Class ;
             rdfs:subClassOf mt:DataItem ;
             rdfs:label "condition"@en-us .


###  https://purl.mtconnect.org/ontology/construct/Controller
mt:Controller rdfv:type owl:Class ;
              rdfs:subClassOf mt:Component ;
              rdfs:label "controller"@en-us .


###  https://purl.mtconnect.org/ontology/construct/ControllerMode
mt:ControllerMode rdfv:type owl:Class ;
                  rdfs:subClassOf mt:Event ;
                  rdfs:label "controller mode"@en-us .


###  https://purl.mtconnect.org/ontology/construct/ControllerModeCapability
mt:ControllerModeCapability rdfv:type owl:Class ;
                            rdfs:subClassOf mt:Capability .


###  https://purl.mtconnect.org/ontology/construct/DataItem
mt:DataItem rdfv:type owl:Class ;
            rdfs:label "data item"@en-us .


###  https://purl.mtconnect.org/ontology/construct/Device
mt:Device rdfv:type owl:Class ;
          rdfs:subClassOf mt:Component ;
          rdfs:label "machine"@en-us .


###  https://purl.mtconnect.org/ontology/construct/Door
mt:Door rdfv:type owl:Class ;
        rdfs:subClassOf mt:Component ;
        rdfs:label "door"@en-us .


###  https://purl.mtconnect.org/ontology/construct/ElectricalSystem
mt:ElectricalSystem rdfv:type owl:Class ;
                    rdfs:subClassOf mt:System ;
                    rdfs:label "electrical system"@en-us .


###  https://purl.mtconnect.org/ontology/construct/Enclosure
mt:Enclosure rdfv:type owl:Class ;
             rdfs:subClassOf mt:Component ;
             rdfs:label "enclosure"@en-us .


###  https://purl.mtconnect.org/ontology/construct/Event
mt:Event rdfv:type owl:Class ;
         rdfs:subClassOf mt:DataItem ;
         rdfs:label "event"@en-us .


###  https://purl.mtconnect.org/ontology/construct/Execution
mt:Execution rdfv:type owl:Class ;
             rdfs:subClassOf mt:Event ;
             rdfs:label "execution"@en-us .


###  https://purl.mtconnect.org/ontology/construct/HydraulicSystem
mt:HydraulicSystem rdfv:type owl:Class ;
                   rdfs:subClassOf mt:System ;
                   rdfs:label "hydraulic system"@en-us .


###  https://purl.mtconnect.org/ontology/construct/Linear
mt:Linear rdfv:type owl:Class ;
          rdfs:subClassOf mt:Axis ;
          owl:disjointWith mt:Rotary ;
          rdfs:label "linear motion system"@en-us .


###  https://purl.mtconnect.org/ontology/construct/Link
mt:Link rdfv:type owl:Class ;
        rdfs:subClassOf mt:Structure ;
        rdfs:label "link"@en-us .


###  https://purl.mtconnect.org/ontology/construct/LubricationSystem
mt:LubricationSystem rdfv:type owl:Class ;
                     rdfs:subClassOf mt:System ;
                     rdfs:label "lubrication system"@en-us .


###  https://purl.mtconnect.org/ontology/construct/Motor
mt:Motor rdfv:type owl:Class ;
         rdfs:subClassOf mt:Component ;
         rdfs:label "motor"@en-us .


###  https://purl.mtconnect.org/ontology/construct/PartOccurrence
mt:PartOccurrence rdfv:type owl:Class ;
                  rdfs:subClassOf mt:Component ;
                  rdfs:label "part"@en-us .


###  https://purl.mtconnect.org/ontology/construct/Path
mt:Path rdfv:type owl:Class ;
        rdfs:subClassOf mt:Controller ;
        rdfs:label "control system path"@en-us .


###  https://purl.mtconnect.org/ontology/construct/PathPosition
mt:PathPosition rdfv:type owl:Class ;
                rdfs:subClassOf mt:Sample ;
                rdfs:label "path position"@en-us .


###  https://purl.mtconnect.org/ontology/construct/PneumaticSystem
mt:PneumaticSystem rdfv:type owl:Class ;
                   rdfs:subClassOf mt:System ;
                   rdfs:label "pneumatic system"@en-us .


###  https://purl.mtconnect.org/ontology/construct/Position
mt:Position rdfv:type owl:Class ;
            rdfs:subClassOf mt:Sample ;
            rdfs:label "position"@en-us .


###  https://purl.mtconnect.org/ontology/construct/PositionActual
mt:PositionActual rdfv:type owl:Class ;
                  rdfs:subClassOf mt:Position ;
                  rdfs:label "actual position"@en-us .


###  https://purl.mtconnect.org/ontology/construct/PositionProgrammed
mt:PositionProgrammed rdfv:type owl:Class ;
                      rdfs:subClassOf mt:Position ;
                      rdfs:label "programmed position"@en-us .


###  https://purl.mtconnect.org/ontology/construct/Room
mt:Room rdfv:type owl:Class ;
        rdfs:subClassOf mt:Component ;
        rdfs:label "room"@en-us .


###  https://purl.mtconnect.org/ontology/construct/Rotary
mt:Rotary rdfv:type owl:Class ;
          rdfs:subClassOf mt:Axis ;
          rdfs:label "rotary motion system"@en-us .


###  https://purl.mtconnect.org/ontology/construct/Sample
mt:Sample rdfv:type owl:Class ;
          rdfs:subClassOf mt:DataItem ;
          rdfs:label "sample"@en-us .


###  https://purl.mtconnect.org/ontology/construct/Sensor
mt:Sensor rdfv:type owl:Class ;
          rdfs:subClassOf mt:Component ;
          rdfs:label "sensor"@en-us .


###  https://purl.mtconnect.org/ontology/construct/Stock
mt:Stock rdfv:type owl:Class ;
         rdfs:subClassOf mt:Component ;
         rdfs:label "stock"@en-us .


###  https://purl.mtconnect.org/ontology/construct/Structure
mt:Structure rdfv:type owl:Class ;
             rdfs:subClassOf mt:Component ;
             rdfs:label "enclosure"@en-us .


###  https://purl.mtconnect.org/ontology/construct/Structures
mt:Structures rdfv:type owl:Class ;
              rdfs:subClassOf mt:Component ;
              rdfs:label "structure"@en-us .


###  https://purl.mtconnect.org/ontology/construct/System
mt:System rdfv:type owl:Class ;
          rdfs:subClassOf mt:Component ;
          rdfs:label "system"@en-us .


###  https://purl.mtconnect.org/ontology/construct/Systems
mt:Systems rdfv:type owl:Class ;
           rdfs:subClassOf mt:Component ;
           rdfs:label "systems"@en-us .


###  https://purl.mtconnect.org/ontology/construct/ThreeRotaryAxes
mt:ThreeRotaryAxes owl:equivalentClass [ owl:intersectionOf ( mt:Device
                                                              [ rdfv:type owl:Restriction ;
                                                                owl:onProperty mt:hasComponent ;
                                                                owl:someValuesFrom [ owl:intersectionOf ( mt:Axes
                                                                                                          [ rdfv:type owl:Restriction ;
                                                                                                            owl:onProperty mt:hasComponent ;
                                                                                                            owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
                                                                                                            owl:onClass mt:Linear
                                                                                                          ]
                                                                                                          [ rdfv:type owl:Restriction ;
                                                                                                            owl:onProperty mt:hasComponent ;
                                                                                                            owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
                                                                                                            owl:onClass mt:Rotary
                                                                                                          ]
                                                                                                        ) ;
                                                                                     rdfv:type owl:Class
                                                                                   ]
                                                              ]
                                                            ) ;
                                         rdfv:type owl:Class
                                       ] ;
                   rdfs:subClassOf mt:Capability .


