###  https://purl.mtconnect.org/ontology/MonitorActiveCapability
mt:MonitorActiveCapability rdfv:type owl:Class ;
                           owl:equivalentClass [ owl:intersectionOf ( mt:Capability
                                                                      [ rdfv:type owl:Restriction ;
                                                                        owl:onProperty mt:isCapabilityOf ;
                                                                        owl:someValuesFrom [ owl:intersectionOf ( mt:Controller
                                                                                                                  [ owl:intersectionOf ( [ rdfv:type owl:Restriction ;
                                                                                                                                           owl:onProperty mt:observes ;
                                                                                                                                           owl:someValuesFrom mt:ControllerMode
                                                                                                                                         ]
                                                                                                                                         [ rdfv:type owl:Restriction ;
                                                                                                                                           owl:onProperty mt:observes ;
                                                                                                                                           owl:someValuesFrom mt:Execution
                                                                                                                                         ]
                                                                                                                                       ) ;
                                                                                                                    rdfv:type owl:Class
                                                                                                                  ]
                                                                                                                ) ;
                                                                                             rdfv:type owl:Class
                                                                                           ]
                                                                      ]
                                                                    ) ;
                                                 rdfv:type owl:Class
                                               ] ;
                           rdfs:subClassOf mt:Capability .


