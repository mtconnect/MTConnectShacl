###  https://purl.mtconnect.org/ontology/ComputeAvailabilityCapability
mt:ComputeAvailabilityCapability rdfv:type owl:Class ;
                                 owl:equivalentClass [ owl:intersectionOf ( mt:Capability
                                                                            [ rdfv:type owl:Restriction ;
                                                                              owl:onProperty mt:isCapabilityOf ;
                                                                              owl:someValuesFrom [ owl:intersectionOf ( mt:Device
                                                                                                                        [ rdfv:type owl:Restriction ;
                                                                                                                          owl:onProperty mt:hasComponent ;
                                                                                                                          owl:someValuesFrom [ owl:intersectionOf ( mt:Controller
                                                                                                                                                                    [ rdfv:type owl:Restriction ;
                                                                                                                                                                      owl:onProperty mt:hasCapability ;
                                                                                                                                                                      owl:someValuesFrom mt:MonitorActiveCapability
                                                                                                                                                                    ]
                                                                                                                                                                  ) ;
                                                                                                                                               rdfv:type owl:Class
                                                                                                                                             ]
                                                                                                                        ]
                                                                                                                      ) ;
                                                                                                   rdfv:type owl:Class
                                                                                                 ]
                                                                            ]
                                                                          ) ;
                                                       rdfv:type owl:Class
                                                     ] ,
                                                     [ owl:intersectionOf ( mt:Capability
                                                                            [ rdfv:type owl:Restriction ;
                                                                              owl:onProperty mt:isCapabilityOf ;
                                                                              owl:someValuesFrom [ owl:intersectionOf ( mt:Device
                                                                                                                        [ rdfv:type owl:Restriction ;
                                                                                                                          owl:onProperty mt:hasComponent ;
                                                                                                                          owl:someValuesFrom [ owl:intersectionOf ( mt:Controller
                                                                                                                                                                    [ rdfv:type owl:Restriction ;
                                                                                                                                                                      owl:onProperty mt:hasComponent ;
                                                                                                                                                                      owl:someValuesFrom [ owl:intersectionOf ( mt:Path
                                                                                                                                                                                                                [ rdfv:type owl:Restriction ;
                                                                                                                                                                                                                  owl:onProperty mt:hasCapability ;
                                                                                                                                                                                                                  owl:someValuesFrom mt:MonitorActiveCapability
                                                                                                                                                                                                                ]
                                                                                                                                                                                                              ) ;
                                                                                                                                                                                           rdfv:type owl:Class
                                                                                                                                                                                         ]
                                                                                                                                                                    ]
                                                                                                                                                                  ) ;
                                                                                                                                               rdfv:type owl:Class
                                                                                                                                             ]
                                                                                                                        ]
                                                                                                                        [ rdfv:type owl:Restriction ;
                                                                                                                          owl:onProperty mt:observes ;
                                                                                                                          owl:someValuesFrom mt:Availability
                                                                                                                        ]
                                                                                                                      ) ;
                                                                                                   rdfv:type owl:Class
                                                                                                 ]
                                                                            ]
                                                                          ) ;
                                                       rdfv:type owl:Class
                                                     ] ;
                                 rdfs:subClassOf mt:Capability ;
                                 rdfs:label "compute availability"@en-us .


###  https://purl.mtconnect.org/ontology/FiveAxisCapability
mt:FiveAxisCapability rdfv:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( mt:Capability
                                                                 [ rdfv:type owl:Restriction ;
                                                                   owl:onProperty mt:isCapabilityOf ;
                                                                   owl:someValuesFrom [ owl:intersectionOf ( mt:Device
                                                                                                             [ rdfv:type owl:Restriction ;
                                                                                                               owl:onProperty mt:hasComponent ;
                                                                                                               owl:someValuesFrom [ owl:intersectionOf ( mt:Axes
                                                                                                                                                         [ rdfv:type owl:Restriction ;
                                                                                                                                                           owl:onProperty mt:hasComponent ;
                                                                                                                                                           owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
                                                                                                                                                           owl:onClass mt:Rotary
                                                                                                                                                         ]
                                                                                                                                                       ) ;
                                                                                                                                    rdfv:type owl:Class
                                                                                                                                  ]
                                                                                                             ]
                                                                                                           ) ;
                                                                                        rdfv:type owl:Class
                                                                                      ]
                                                                 ]
                                                               ) ;
                                            rdfv:type owl:Class
                                          ] ;
                      rdfs:subClassOf mt:FourAxisCapability .


###  https://purl.mtconnect.org/ontology/FourAxisCapability
mt:FourAxisCapability rdfv:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( mt:Capability
                                                                 [ rdfv:type owl:Restriction ;
