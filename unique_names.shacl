@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix data: <https://mtconnect.org/data/> .
@prefix val: <https://purl.mtconnect.org/shacl/> .
@prefix mt: <https://purl.mtconnect.org/ontology/> .

val:NamesShouldBeUnique
    a sh:PredicateShape ;
    sh:targetSubjectsOf mt:hasName ;
    sh:sparql [
      a sh:SPARQLConstraint ;
        sh:prefixes mt: ;
        sh:message "All `name` properties **SHOULD** be unique." ;
        sh:severity sh:Warning ;
        sh:select """
            SELECT $this ?name WHERE {
                $this <https://purl.mtconnect.org/ontology/hasName> ?name .
                ?other <https://purl.mtconnect.org/ontology/hasName> ?name .
                FILTER ($this != ?other)
            }
        """ ;
    ] .

val:NamesAtTheSameLevelMustBeUnique
    a sh:NodeShape ;
    sh:targetClass mt:Component ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes mt: ;
        sh:message "All `name` properties at the same level **MUST** be unique." ;
        sh:select """
            SELECT $this ?name ?sub1 ?sub2 WHERE {
                $this <https://purl.mtconnect.org/ontology/hasComponent> ?sub1 .
                ?sub1 <https://purl.mtconnect.org/ontology/hasName> ?name .
                $this <https://purl.mtconnect.org/ontology/hasComponent> ?sub2 .
                ?sub2 <https://purl.mtconnect.org/ontology/hasName> ?name .
                FILTER (?sub1 != ?sub2)
            }
        """ ;
    ] .